onboarding = false

[theme.custom]
accent   = "@base0D@"
panel_bg = "@base00@"
surface0 = "@base01@"
surface1 = "@base02@"
overlay0 = "@base03@"
overlay1 = "@base04@"
text     = "@base05@"
subtext0 = "@base04@"
red      = "@base08@"
peach    = "@base09@"
yellow   = "@base0A@"
green    = "@base0B@"
teal     = "@base0C@"
blue     = "@base0D@"
mauve    = "@base0E@"

[terminal]
new_cwd = "follow"

[session]
resume_agents_on_restore = true

[remote]
manage_ssh_config = false

# herdr is updated via the nix flake + rebuild, never its built-in updater
# (which downloads a binary into the immutable nix store). Disable the
# background version check so it stops asking to "detach to update".
[update]
version_check = false

[ui.toast]
delivery = "system"

# Daily journal: popup nvim on today's note (journal-open creates the file
# from the AM/PM template and carries over open tasks from yesterday).
[[keys.command]]
key = "ctrl+alt+j"
type = "popup"
description = "Open daily journal"
command = "nvim \"$(journal-open)\""
width = "90%"
height = "90%"
