:root {
  /* surface layers */
  --sidebar-background-color:   @base01@ !important;
  --sidebar-text-color:         @base05@ !important;
  --sidebar-border-color:       @base02@ !important;

  /* toolbar / search field */
  --toolbar-bgcolor:                      @base01@ !important;
  --lwt-toolbar-field-background-color:   @base00@ !important;
  --lwt-toolbar-field-color:              @base05@ !important;
  --lwt-toolbar-field-border-color:       @base03@ !important;
  --lwt-toolbar-field-focus:              @base01@ !important;

  /* tabs */
  --tabline-color:                  @base0D@ !important;
  --tabs-tabbar-background-color:   @base00@ !important;

  /* buttons */
  --toolbarbutton-icon-fill:          @base05@ !important;
  --toolbarbutton-hover-background:   @base02@ !important;
  --toolbarbutton-active-background:  @base03@ !important;

  /* focus ring */
  --focus-outline-color: @base0D@ !important;

  /* font size from stylix */
  --default-font-size: @fontSize@px !important;
}

/* Folder pane */
#folderTree,
#folderPaneBox {
  background-color: @base00@ !important;
  color:            @base05@ !important;
}

/* Thread pane */
#threadTree {
  background-color: @base00@ !important;
  color:            @base05@ !important;
}

/* Selected row accent */
.selected,
[selected="true"],
richlistitem[selected="true"] {
  background-color: @base02@ !important;
  color:            @base05@ !important;
  outline-color:    @base0D@ !important;
}

/* Unread count badge */
.folderNameCell .unreadCount {
  color: @base0D@ !important;
}

/* Tag / label colors pulled from stylix */
.tag-1 { color: @base08@ !important; } /* Important → red   */
.tag-2 { color: @base0A@ !important; } /* Work      → yellow */
.tag-3 { color: @base0B@ !important; } /* Personal  → green  */
.tag-4 { color: @base09@ !important; } /* To Do     → orange */
.tag-5 { color: @base0E@ !important; } /* Later     → purple */
