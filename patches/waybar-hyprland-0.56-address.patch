 namespace waybar::modules::hyprland {
 
+// Hyprland 0.56 replaced the numeric "id" field of workspaces with a string
+// "address" field in its IPC replies. Try the legacy field first and fall back
+// to parsing "address" so workspaces keep a stable numeric id (and deduplicate
+// correctly against persistent workspaces).
+static int getWorkspaceId(const Json::Value& ws) {
+  if (ws["id"].isInt()) {
+    return ws["id"].asInt();
+  }
+  if (ws["address"].isString()) {
+    const auto address = ws["address"].asString();
+    if (address == "special") {
+      return -99;
+    }
+    try {
+      return std::stoi(address);
+    } catch (const std::exception&) {
+      return 0;
+    }
+  }
+  return 0;
+}
